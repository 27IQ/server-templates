PACK_NAME="docker_1.21.1_neo_forge_prism"
MOTD="Prism NeoForge 1.21.1"
SERVER_PORT="25565"
RCON_PWD="change_me"
RCON_HOST="127.0.0.1"
RCON_PORT="25575"
ENABLE_WHITELIST="true"
MEMORY="8G"
JAVA_ARGS="-XX:+UseZGC -XX:+ZGenerational -XX:+DisableExplicitGC -XX:+PerfDisableSharedMem -XX:+AlwaysPreTouch"
SERVER_DIR="./server"
RESTART_INTERVAL="24h"
BACKUP_ENABLED="true"
BACKUP_DIR="./backups"
DIFFICULTY="hard"
# Only needed for CurseForge links. Use single quotes to preserve $ in API keys.
CF_API_KEY=''
